# Local development only. Production requires a private PostgreSQL service.
DATABASE_URL="postgresql://wholseler:wholseler_local@127.0.0.1:54329/wholseler?schema=public"
WEB_ORIGIN="http://127.0.0.1:3000"
API_INTERNAL_URL="http://127.0.0.1:3001"
API_PORT=3001
WEB_PORT=3000
TZ="Asia/Kolkata"
# Development OTPs are shown only on loopback, never in production.
AUTH_MODE="development"
OTP_HASH_SECRET="replace-with-at-least-32-random-characters-before-production"
OTP_PROVIDER="msg91"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# Images are local in development. S3 / R2 is required in production.
STORAGE_MODE="local"
LOCAL_STORAGE_PATH=".data/uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SEED_SAMPLE_DATA=true

# Outbound alerts: local records jobs but sends nothing. Switch after provider setup.
NOTIFICATION_MODE="local"
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM=""
SMS_SENDER_ID=""
# MSG91 approved flows use TITLE, MESSAGE and LINK recipient variables.
SMS_FLOW_NEW_ARRIVALS=""
SMS_FLOW_STOCK_ALERTS=""
SMS_FLOW_INQUIRY_ALERTS=""
SMS_FLOW_PAYMENT_REMINDERS=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Each approved Meta template needs three body parameters: title, message, link.
WHATSAPP_TEMPLATE_NEW_ARRIVALS=""
WHATSAPP_TEMPLATE_STOCK_ALERTS=""
WHATSAPP_TEMPLATE_INQUIRY_ALERTS=""
WHATSAPP_TEMPLATE_PAYMENT_REMINDERS=""
