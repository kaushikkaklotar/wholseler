# Copy to .env.production on the deployment machine; never commit real secrets.
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wholseler?schema=public&sslmode=require"
WEB_ORIGIN="https://wholesale.example.com"
API_INTERNAL_URL="http://127.0.0.1:3001"
API_PORT=3001
WEB_PORT=3000
WEB_HOST="0.0.0.0"
TZ="Asia/Kolkata"
AUTH_MODE="sms"
OTP_HASH_SECRET=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
STORAGE_MODE="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SEED_SAMPLE_DATA=false
# Alerts remain disabled until real sender / approved template tests pass.
NOTIFICATION_MODE="local"
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM=""
SMS_SENDER_ID=""
SMS_FLOW_NEW_ARRIVALS=""
SMS_FLOW_STOCK_ALERTS=""
SMS_FLOW_INQUIRY_ALERTS=""
SMS_FLOW_PAYMENT_REMINDERS=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_TEMPLATE_NEW_ARRIVALS=""
WHATSAPP_TEMPLATE_STOCK_ALERTS=""
WHATSAPP_TEMPLATE_INQUIRY_ALERTS=""
WHATSAPP_TEMPLATE_PAYMENT_REMINDERS=""
